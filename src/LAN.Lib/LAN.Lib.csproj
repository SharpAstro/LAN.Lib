<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LAN.Lib</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No version properties here. AssemblyVersion and VersionPrefix are both derived from the one
         place the number is written (VersionMajorMinor in the repo-root Directory.Build.props). The
         NuGet package version is composed in CI via $(VERSION_PREFIX)$(VERSION_REV)+$(VERSION_HASH),
         whose prefix is read back from that same property. Bump it THERE; do not restate it here. -->
    <PackageId>LAN.Lib</PackageId>
    <Description>Zero-dependency LAN peer discovery: a symmetric UDP announce beacon + self-expiring peer table over a shared broadcast domain, filtered by service name, with a stable-node-id concept and an extensible property bag. TimeProvider-driven (deterministic in tests), AOT/trim friendly, with a DI extension for the .NET generic host.</Description>
    <PackageTags>LAN;Discovery;UDP;Broadcast;Beacon;Peer;Networking;ServiceDiscovery</PackageTags>
    <Authors>Sebastian Godelet</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/LAN.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LAN.Lib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
